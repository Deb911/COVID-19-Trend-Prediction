# ===================================================================
# COVID-19 Trend Prediction Platform - Configuration Environment
# ===================================================================

# Application Security
SECRET_KEY=generate-a-strong-secret-key-for-jwt-session-cryptography
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration (Defaults to SQLite for instant plug-and-play, or PostgreSQL)
DATABASE_URL=sqlite:///./covid_healthcare.db
# For PostgreSQL:
# DATABASE_URL=postgresql://postgres:password@localhost:5432/covid_db

# Real Email Service / SMTP Configuration (For OTP Delivery & Password Resets)
# If left blank, OTP codes are logged securely to server console for local testing.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-organization-email@gmail.com
SMTP_PASSWORD=your-app-password
EMAILS_FROM_EMAIL=noreply@covid-predict.health.gov
EMAILS_FROM_NAME=COVID-19 Epidemic Intelligence Portal

# OTP Security Settings
OTP_EXPIRE_MINUTES=5
OTP_MAX_ATTEMPTS=3
OTP_RESEND_COOLDOWN_SECONDS=60
